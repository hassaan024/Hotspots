generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/clientB"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_USERS")
}

model users {
  username     String @id
  email        String @unique
  passwordHash String
}

model followers {
  follower    String
  followee    String
  followed_at DateTime @default(now()) // <-- was String; use DateTime

  @@id([follower, followee]) // <-- composite PK to match your SQL
  @@map("followers") // maps to your existing table name
}
