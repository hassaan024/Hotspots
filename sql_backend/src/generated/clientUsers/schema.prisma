generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/clientB"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_USERS")
}

model users {
  username String @id @db.VarChar(25)
  email    String @unique(map: "users_pk") @db.VarChar(50)
  password String @db.VarChar(255)
}
